<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-gray-100 text-gray-900">
    <header class="border-b border-gray-300 bg-white">
      <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-4 py-3 sm:px-5 lg:px-8">
        <div class="flex items-center gap-3">
          <div class="grid size-9 place-items-center rounded-sm bg-gray-900 text-base font-bold text-white">
            S
          </div>
          <div>
            <h1 class="text-base font-semibold tracking-tight">Styra Live</h1>
            <p class="text-xs text-gray-500">Local interaction console</p>
          </div>
        </div>

        <div
          id="connection-status"
          class="flex items-center gap-2 border border-gray-300 bg-gray-50 px-3 py-1.5 text-xs font-medium text-gray-700"
        >
          <span class={[
            "size-2 rounded-full",
            if(@connected, do: "bg-emerald-600", else: "bg-red-600")
          ]}></span>
          <span>{if @connected, do: @service || "Connected", else: "Offline"}</span>
        </div>
      </div>
    </header>

    <div :if={@error} class="mx-auto max-w-[1600px] px-4 pt-4 sm:px-5 lg:px-8">
      <div
        class="flex items-center gap-3 border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800"
        role="alert"
      >
        <.icon name="hero-exclamation-triangle" class="size-5 shrink-0" />
        <span>{@error}</span>
      </div>
    </div>

    <div class="mx-auto grid max-w-[1600px] gap-4 px-3 py-4 sm:px-5 lg:grid-cols-[22rem_minmax(0,1fr)] lg:px-8">
      <aside class={[
        "overflow-hidden border border-gray-300 bg-white",
        @selected_id && "hidden lg:block"
      ]}>
        <div class="flex items-center justify-between border-b border-gray-300 bg-gray-50 px-4 py-2.5">
          <div>
            <h2 class="text-sm font-semibold">Interactions</h2>
            <p class="text-xs text-gray-500">
              {if @connected, do: "#{@interaction_count} live", else: "Server unavailable"}
            </p>
          </div>
          <span
            :if={@refreshing}
            class="size-4 animate-spin rounded-full border-2 border-gray-300 border-t-gray-700"
          ></span>
        </div>

        <div
          id="interactions"
          phx-update="stream"
          class="max-h-[calc(100dvh-11.5rem)] divide-y divide-gray-200 overflow-y-auto sm:max-h-[calc(100dvh-12rem)]"
        >
          <div
            id="interactions-empty"
            class="hidden px-4 py-12 text-center text-sm text-gray-500 only:block"
          >
            No live interactions.
          </div>
          <button
            :for={{dom_id, interaction} <- @streams.interactions}
            id={dom_id}
            type="button"
            phx-click="select"
            phx-value-id={interaction["id"]}
            class={[
              "block min-h-16 w-full touch-manipulation border-l-2 px-3 py-2.5 text-left",
              if(@selected_id == interaction["id"],
                do: "border-l-gray-900 bg-gray-100",
                else: "border-l-transparent hover:bg-gray-50"
              )
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <span class="truncate text-sm font-semibold">{display_name(interaction)}</span>
              <span class="flex shrink-0 items-center gap-1.5 text-[11px] uppercase tracking-wide text-gray-500">
                <span class={["size-1.5 rounded-full", activity_class(interaction["activity"])]}></span>
                {interaction["activity"]}
              </span>
            </div>
            <p class="mt-0.5 truncate font-mono text-[11px] text-gray-500">
              {selection_name(interaction)}
            </p>
            <p class="mt-1.5 line-clamp-2 text-sm leading-snug text-gray-600">
              {interaction["last_message"] || "No agent message yet"}
            </p>
          </button>
        </div>
      </aside>

      <section class={[
        "min-h-[calc(100dvh-8rem)] min-w-0 flex-col overflow-hidden border border-gray-300 bg-white lg:flex lg:min-h-[calc(100vh-8.5rem)]",
        if(@selected_id, do: "flex", else: "hidden")
      ]}>
        <%= if interaction = @selected_interaction do %>
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-300 bg-gray-50 px-3 py-2 sm:gap-3 sm:px-4">
            <div class="flex min-w-0 flex-1 items-center gap-2">
              <button
                id="back-to-interactions"
                type="button"
                aria-label="Back to interactions"
                class="grid size-10 shrink-0 touch-manipulation place-items-center border border-gray-300 bg-white text-gray-600 hover:bg-gray-100 lg:hidden"
                phx-click="deselect"
              >
                <.icon name="hero-chevron-left" class="size-5" />
              </button>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h2 class="truncate text-sm font-semibold">{display_name(interaction)}</h2>
                  <span class="border border-gray-300 bg-white px-1.5 py-0.5 text-[11px] text-gray-600">
                    {interaction["activity"]}
                  </span>
                </div>
                <p class="truncate font-mono text-xs text-gray-500">
                  {interaction["workspace"]}
                </p>
              </div>
            </div>
            <div class="flex shrink-0 gap-2">
              <button
                id="interrupt-button"
                class="min-h-9 touch-manipulation border border-gray-300 bg-white px-3 text-sm text-gray-700 hover:bg-gray-100"
                phx-click="action"
                phx-value-name="interrupt"
              >
                Interrupt
              </button>
              <button
                id="stop-button"
                class="min-h-9 touch-manipulation border border-red-300 bg-white px-3 text-sm text-red-700 hover:bg-red-50"
                phx-click="action"
                phx-value-name="stop"
              >
                Stop
              </button>
            </div>
          </div>

          <div
            id="transcript"
            phx-update="stream"
            class="flex-1 space-y-2 overflow-y-auto overscroll-contain bg-gray-50 p-3 sm:p-4"
          >
            <div
              id="transcript-empty"
              class="hidden h-full min-h-72 place-items-center text-center only:grid"
            >
              <div>
                <.icon name="hero-chat-bubble-left-right" class="mx-auto size-10 text-gray-400" />
                <p class="mt-3 text-sm text-gray-500">Waiting for interaction events…</p>
              </div>
            </div>
            <article
              :for={{dom_id, item} <- @streams.updates}
              id={dom_id}
              class={[
                "border px-3 py-2",
                if(conversational?(item),
                  do:
                    if(user_message?(item),
                      do: "ml-4 border-gray-400 bg-white sm:ml-10",
                      else: "mr-4 border-gray-300 bg-white sm:mr-10"
                    ),
                  else: "border-gray-200 bg-gray-100"
                )
              ]}
            >
              <div class="mb-1 flex items-center justify-between gap-3">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-gray-500">
                  {update_kind(item) |> String.replace("_", " ")}
                </span>
                <span class="font-mono text-[10px] text-gray-400">#{item["sequence"]}</span>
              </div>
              <p class="whitespace-pre-wrap break-words text-sm leading-6 text-gray-800">
                {update_text(item)}
              </p>
            </article>
          </div>

          <div class="border-t border-gray-300 bg-white p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
            <.form
              for={@message_form}
              id="message-form"
              phx-submit="send"
              class="[&>div]:mb-0"
            >
              <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_9rem] sm:gap-3 [&>div]:mb-0 [&>div]:min-w-0">
                <div class="relative [&>div]:mb-0">
                  <.input
                    field={@message_form[:text]}
                    type="textarea"
                    aria-label="Message"
                    placeholder="Send a message to this interaction…"
                    rows="2"
                    readonly={@audio_state != :idle}
                    class="min-h-20 w-full resize-none border border-gray-300 bg-white px-3 py-2 pr-14 text-base text-gray-900 outline-none placeholder:text-gray-400 focus:border-gray-900 sm:min-h-16 sm:text-sm"
                  />
                  <button
                    id="voice-recorder"
                    type="button"
                    phx-hook="VoiceRecorder"
                    phx-update="ignore"
                    data-state="idle"
                    aria-label="Record a voice message"
                    title="Record a voice message"
                    class="voice-recorder absolute bottom-2 right-2 grid size-10 touch-manipulation place-items-center rounded-full border border-gray-300 bg-white text-gray-600 shadow-sm transition hover:border-gray-500 hover:bg-gray-50 sm:size-9"
                  >
                    <.icon name="hero-microphone" class="voice-recorder-mic size-5" />
                    <span class="voice-recorder-stop size-3 rounded-sm bg-current"></span>
                  </button>
                </div>
                <div class="flex gap-2 sm:flex-col [&>div]:mb-0 [&>div]:min-w-0 [&>div]:flex-1">
                  <.input
                    field={@message_form[:contract]}
                    type="select"
                    aria-label="Answer contract"
                    options={contract_options()}
                    disabled={@audio_state != :idle}
                    class="h-10 w-full border border-gray-300 bg-white px-2 text-sm text-gray-800 outline-none focus:border-gray-900 sm:h-9"
                  />
                  <button
                    id="send-button"
                    class="flex h-10 shrink-0 touch-manipulation items-center justify-center gap-2 border border-gray-900 bg-gray-900 px-5 text-sm font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:opacity-50 phx-submit-loading:opacity-60 sm:h-9 sm:px-4"
                    type="submit"
                    disabled={@audio_state != :idle}
                  >
                    Send <.icon name="hero-arrow-up" class="size-4" />
                  </button>
                </div>
              </div>
            </.form>

            <form id="audio-upload-form" phx-change="validate_audio" class="hidden">
              <.live_file_input upload={@uploads.audio} />
            </form>

            <div
              :if={@audio_state != :idle}
              id="voice-status"
              class="mt-2 flex items-center gap-2 text-xs font-medium text-gray-600"
              role="status"
            >
              <span class={[
                "size-2 rounded-full",
                if(@audio_state == :recording,
                  do: "animate-pulse bg-red-600",
                  else: "bg-amber-500"
                )
              ]}></span>
              {audio_status(@audio_state)}
            </div>
            <p
              :for={error <- upload_errors(@uploads.audio)}
              class="mt-2 text-xs font-medium text-red-700"
            >
              {upload_error(error)}
            </p>
          </div>
        <% else %>
          <div class="grid flex-1 place-items-center p-10 text-center">
            <div class="max-w-sm">
              <div class="mx-auto grid size-14 place-items-center border border-gray-300 bg-gray-50">
                <.icon name="hero-command-line" class="size-7 text-gray-400" />
              </div>
              <h2 class="mt-5 text-base font-semibold">Select an interaction</h2>
              <p class="mt-2 text-sm leading-6 text-gray-600">
                Choose a live Styra session to stream its events and send the next turn.
              </p>
            </div>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</Layouts.app>
