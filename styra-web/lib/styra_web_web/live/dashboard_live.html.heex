<Layouts.app flash={@flash}>
  <div id="styra-console" class="styra-console" phx-hook="ConsoleKeys">
    <header class="console-header">
      <h1>styra <span>/ live</span></h1>
      <div id="connection-status" class="connection-status" data-connected={to_string(@connected)}>
        <span aria-hidden="true">●</span>
        {if @connected, do: @service || "connected", else: "offline"}
      </div>
    </header>

    <div :if={@error} id="console-error" class="console-error" role="alert">
      <.icon name="hero-exclamation-triangle" class="size-4 shrink-0" />
      {@error}
    </div>

    <section class="console-pane" aria-label="Interaction console">
      <div class="pane-title">
        <button
          id="back-to-interactions"
          type="button"
          phx-click="toggle_interactions"
          aria-expanded={to_string(@navigator_open)}
          aria-controls="interaction-navigator"
          class="navigator-toggle"
        >
          <span aria-hidden="true">{if @navigator_open, do: "▾", else: "▸"}</span>
          live interactions <span class="count">{@interaction_count}</span>
          <kbd>l</kbd>
        </button>
        <span :if={@selected_interaction} class="pane-selection">
          {display_name(@selected_interaction)}
        </span>
      </div>

      <div id="interaction-navigator" class="interaction-navigator" hidden={!@navigator_open}>
        <div class="navigator-heading">
          <span>all workspaces · live interactions</span>
          <span class="navigator-hint">↑ ↓ move · Enter open · Esc close</span>
        </div>
        <div id="interactions" phx-update="stream" class="interaction-list">
          <div id="interactions-empty" class="stream-empty hidden only:block">
            {if @connected, do: "No live interactions.", else: "Waiting for the Styra server…"}
          </div>
          <button
            :for={{dom_id, interaction} <- @streams.interactions}
            id={dom_id}
            type="button"
            phx-click={JS.push("select") |> JS.focus(to: "#transcript")}
            phx-value-id={interaction["id"]}
            aria-current={if @selected_id == interaction["id"], do: "true", else: "false"}
            class="interaction-row"
          >
            <span class="interaction-main">
              <span
                class="activity-marker"
                data-activity={interaction["activity"]}
                aria-label={interaction["activity"]}
              >
                {activity_marker(interaction["activity"])}
              </span>
              <span class="interaction-name">{display_name(interaction)}</span>
              <span class="interaction-model">{selection_name(interaction)}</span>
              <span class="interaction-activity" data-activity={interaction["activity"]}>{interaction[
                "activity"
              ]}</span>
            </span>
            <span class="interaction-context">{interaction["workspace"]}</span>
            <span :if={interaction["last_message"]} class="interaction-preview">{interaction[
              "last_message"
            ]}</span>
          </button>
        </div>
      </div>

      <div class="log-heading">
        <h2>interaction log</h2>
        <div :if={@selected_interaction} class="log-actions">
          <button
            id="interrupt-button"
            type="button"
            phx-click="action"
            phx-value-name="interrupt"
          >interrupt</button>
          <button id="stop-button" type="button" phx-click="action" phx-value-name="stop">stop</button>
        </div>
      </div>

      <div
        id="transcript"
        phx-update="stream"
        phx-hook="FollowLog"
        class="interaction-log"
        tabindex="0"
        aria-label="Interaction log"
      >
        <div id="transcript-empty" class="log-empty hidden only:grid">
          <%= cond do %>
            <% @selected_id && !@selected_interaction -> %>
              <p>Loading interaction…</p>
            <% @selected_interaction -> %>
              <div>
                <p>Waiting for interaction events…</p><span>Press i to write a message.</span>
              </div>
            <% true -> %>
              <div>
                <p>styra</p><span>Choose a live interaction above to open its log.</span>
              </div>
          <% end %>
        </div>
        <article
          :for={{dom_id, item} <- @streams.updates}
          id={dom_id}
          class={[
            "log-entry",
            conversational?(item) && "conversation-entry",
            user_message?(item) && "user-entry"
          ]}
        >
          <span class="entry-sequence" aria-label={"Event #{item["sequence"]}"}>{item["sequence"]}</span>
          <div class="entry-content">
            <span class="entry-label">{update_label(item)}</span>
            <p>{update_text(item)}</p>
          </div>
        </article>
      </div>

      <div :if={@selected_interaction} id="interaction-status" class="interaction-status">
        <span class="status-activity" data-activity={@selected_interaction["activity"]}>
          {activity_marker(@selected_interaction["activity"])} {@selected_interaction["activity"]}
        </span>
        <span class="status-workspace">{@selected_interaction["workspace"]}</span>
        <span class="status-model">{selection_name(@selected_interaction)}</span>
      </div>
      <footer class="console-footer">
        <button
          id="compose-button"
          type="button"
          phx-click="open_composer"
          disabled={!@selected_interaction}
        >
          <kbd>i</kbd> {if @message_form[:text].value == "", do: "message", else: "continue draft"}
        </button>
        <span><kbd>l</kbd> interactions</span>
        <span class="footer-note">local session console</span>
      </footer>
    </section>

    <div :if={@composer_open && @selected_interaction} id="message-modal" class="message-overlay">
      <div class="message-backdrop" aria-hidden="true" phx-click="close_composer"></div>
      <.focus_wrap
        id="message-dialog"
        class="message-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="message-title"
        aria-describedby="message-help"
        phx-mounted={JS.focus(to: "#message-text")}
        phx-remove={JS.focus(to: "#compose-button")}
      >
        <div class="message-titlebar">
          <h2 id="message-title">message <span>· {display_name(@selected_interaction)}</span></h2>
          <span class="message-model">{selection_name(@selected_interaction)}</span>
          <button
            id="close-composer"
            type="button"
            phx-click="close_composer"
            aria-label="Close message"
            disabled={@audio_state != :idle}
          >
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </div>
        <.form for={@message_form} id="message-form" phx-change="update_draft" phx-submit="send">
          <.input
            id="message-text"
            field={@message_form[:text]}
            type="textarea"
            aria-label="Message"
            placeholder="Type a message, Enter to send…"
            rows="5"
            readonly={@audio_state != :idle}
            class="message-text"
          />
          <div class="message-controls">
            <div class="contract-control">
              <label for="message-contract">answer</label>
              <.input
                id="message-contract"
                field={@message_form[:contract]}
                type="select"
                aria-label="Answer contract"
                options={contract_options()}
                disabled={@audio_state != :idle}
                class="contract-select"
              />
            </div>
            <button
              id="voice-recorder"
              type="button"
              phx-hook="VoiceRecorder"
              phx-update="ignore"
              data-state="idle"
              aria-label="Record a voice message"
              title="Record a voice message"
              class="voice-recorder"
            >
              <.icon name="hero-microphone" class="voice-recorder-mic size-4" />
              <span class="voice-recorder-stop size-3 bg-current"></span>
            </button>
            <button
              id="send-button"
              class="send-button"
              type="submit"
              disabled={@audio_state != :idle}
            >send ↵</button>
          </div>
        </.form>
        <form id="audio-upload-form" phx-change="validate_audio" class="hidden">
          <.live_file_input upload={@uploads.audio} />
        </form>
        <div :if={@audio_state != :idle} id="voice-status" class="voice-status" role="status">
          {audio_status(@audio_state)}
        </div>
        <p :for={error <- upload_errors(@uploads.audio)} class="console-error">
          {upload_error(error)}
        </p>
        <p :if={@error} class="message-error" role="alert">{@error}</p>
        <div id="message-help" class="message-help">
          <span>Enter send · Shift+Enter newline</span><span>Esc keep draft & close</span>
        </div>
      </.focus_wrap>
    </div>
  </div>
</Layouts.app>
